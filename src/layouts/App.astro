---
import { ClientRouter } from "astro:transitions";
import "$styles/global.css";
import "$styles/cursor.css";

const title = "TuyuriTio";
const description = "Understanding asynchronously...";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />

		<link rel="icon" type="image/jpeg" href="/favicon.jpg" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet" />

		<title>{title}</title>

		<ClientRouter />

		<script>
			// Decode obfuscated mailto links
			document.addEventListener("astro:page-load", () => {
				document.querySelectorAll<HTMLAnchorElement>('a[href^="mailto:["]').forEach(link => {
					const match = link.getAttribute("href")?.match(/mailto:\[(.*?)\]/);
					if (match?.[1]) link.href = `mailto:${atob(match[1])}`;
				});
			});

			// Custom cursor & magnetic effect
			if (window.matchMedia("(pointer: fine)").matches) {
				const dot = {
					style: document.getElementById("cursor-dot")!.style,
					x: 0,
					y: 0
				};

				const ring = {
					style: document.getElementById("cursor-ring")!.style,
					x: 0,
					y: 0,
					width: 0,
					height: 0
				};

				const target = {
					$: null as HTMLElement | null,
					rectangle: null as DOMRect | null,
					width: 0,
					height: 0
				};

				const tooltip = document.getElementById("tooltip")!;

				/**
				 * Whether the page has just loaded.
				 * Used to prevent the cursor from unexpectedly appearing before it moves to the actual position of the mouse.
				 */
				let initial = true;

				document.addEventListener("astro:page-load", () => {
					dot.style.opacity = initial ? "0" : "1";
					target.$ = null;
					target.width = 32;
					target.height = 32;
					tooltip.style.opacity = "0";
					tooltip.style.visibility = "hidden";

					document.querySelectorAll<HTMLElement>("[data-magnetic]").forEach(magnetic);
				});

				document.addEventListener("mousemove", e => {
					dot.x = e.clientX;
					dot.y = e.clientY;
					dot.style.transform = `translate(${dot.x}px, ${dot.y}px)`;

					if (initial) {
						initial = false;

						ring.x = dot.x;
						ring.y = dot.y;
						dot.style.opacity = "1";
						ring.style.opacity = "1";
					}
				});

				/**
				 * Controls how quickly the ring resizes to fit targets.
				 * @constant 0 < stiffness < 1
				 */
				const stiffness = 0.13;

				/**
				 * Controls how quickly the ring moves to the target position.
				 */
				const sizeSmooth = 0.2;

				/**
				 * Named function (not IIFE) so TS CFA analyses the body in isolation
				 */
				function tick() {
					if (target.$) {
						target.rectangle = target.$.getBoundingClientRect();
						ring.x += target.rectangle.left + target.rectangle.width / 2 - ring.x;
						ring.y += target.rectangle.top + target.rectangle.height / 2 - ring.y;
					} else {
						ring.x += (dot.x - ring.x) * stiffness;
						ring.y += (dot.y - ring.y) * stiffness;
					}

					ring.width += (target.width - ring.width) * sizeSmooth;
					ring.height += (target.height - ring.height) * sizeSmooth;

					ring.style.width = `${ring.width}px`;
					ring.style.height = `${ring.height}px`;
					ring.style.transform = `translate(${ring.x}px, ${ring.y}px)`;

					if (tooltip.style.visibility === "visible") {
						tooltip.style.left = `${ring.x}px`;
						tooltip.style.top = `${ring.y - ring.height / 2}px`;
					}

					requestAnimationFrame(tick);
				}
				requestAnimationFrame(tick);

				/**
				 * Adds magnetic effect to an element.
				 * @param element The target element
				 */
				function magnetic(element: HTMLElement) {
					element.addEventListener("mouseenter", () => {
						target.$ = element;
						target.rectangle = element.getBoundingClientRect();

						dot.style.opacity = "0";

						const pad = 10;
						target.width = target.rectangle.width + pad * 2;
						target.height = target.rectangle.height + pad * 2;

						const targetRadius = parseFloat(getComputedStyle(element).borderRadius);
						const circle = targetRadius >= Math.min(target.rectangle.width, target.rectangle.height) / 2;
						ring.style.borderRadius = circle ? "50%" : `${targetRadius + pad}px`;

						element.style.transition = "transform 0.1s linear";

						if (element.dataset.tooltip) {
							tooltip.textContent = element.dataset.tooltip;
							tooltip.style.opacity = "1";
							tooltip.style.visibility = "visible";

							tooltip.style.left = `${target.rectangle.left + target.rectangle.width / 2}px`;
							tooltip.style.top = `${target.rectangle.top - target.rectangle.height / 2}px`;
						}
					});

					const strength = parseFloat(element.dataset.magnetic!);

					element.addEventListener("mousemove", event => {
						const dx = event.clientX - (target.rectangle!.left + target.rectangle!.width / 2);
						const dy = event.clientY - (target.rectangle!.top + target.rectangle!.height / 2);
						element.style.transform = `translate(${dx * strength}px, ${dy * strength}px)`;
					});

					element.addEventListener("mouseleave", () => {
						target.$ = null;
						target.rectangle = null;

						dot.style.opacity = "1";
						target.width = 32;
						target.height = 32;
						ring.style.borderRadius = "50%";

						element.style.transition = "transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)";
						element.style.transform = "";

						tooltip.style.opacity = "0";
						tooltip.style.visibility = "hidden";
					});
				}
			}
		</script>
	</head>
	<body>
		<div id="cursor-dot" transition:persist></div>
		<div id="cursor-ring" transition:persist></div>
		<div id="tooltip" transition:persist></div>
		<slot />
	</body>
</html>
