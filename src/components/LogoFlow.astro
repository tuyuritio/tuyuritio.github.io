---
interface Props {
	items: { name: string; logo: string }[];
	reverse?: boolean;
}

const { items = [], reverse = false } = Astro.props;
---

<style is:global>
	@keyframes marquee {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	.animate-marquee {
		animation: marquee var(--marquee-duration) linear infinite;

		&.reverse {
			animation-direction: reverse;
		}
	}

	.mask {
		mask-image: linear-gradient(to right, transparent, black 5rem, black calc(100% - 5rem), transparent);
	}
</style>

<div class="relative overflow-x-clip mask">
	<div style={`--marquee-duration: ${items.length * 3}s;`} class="flex gap-15 pl-15 w-max animate-marquee" class:list={[reverse && "reverse"]}>
		{
			items.concat(items).map(tech => (
				<div class="flex items-center gap-2">
					<i class:list={["w-6 h-6", "iconify-color", tech.logo]} />
					<span class="text-xs">{tech.name}</span>
				</div>
			))
		}
	</div>
</div>
